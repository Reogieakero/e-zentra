# ===== Zentra Backend Environment Configuration =====
# Copy to .env and adjust. NEVER commit .env.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Local Postgres. In production point this at your Supabase Postgres connection string,
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://zentra:zentra_dev_password@localhost:5432/zentra?schema=public"
# Separate test database (used by the Jest integration suite)
TEST_DATABASE_URL="postgresql://zentra:zentra_dev_password@localhost:5432/zentra_test?schema=public"

# --- Redis ---
# Upstash Redis (TLS): replace with your Upstash "Connection String" from the console.
# Format: rediss://default:<TOKEN>@<host>.upstash.io:6379
REDIS_URL="rediss://default:<UPSTASH_TOKEN>@<your-endpoint>.upstash.io:6379"
# Separate Redis db index for tests (avoid clobbering dev cache/rate-limit keys)
TEST_REDIS_URL="redis://localhost:6379/1"

# --- Auth ---
# Use a long random value in production: `openssl rand -hex 64`
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
# Access token lifetime (default 15 minutes)
JWT_ACCESS_TTL="15m"
# Refresh token lifetime (default 30 days)
JWT_REFRESH_TTL_DAYS=30

# --- CORS ---
# Comma-separated allow-list, never "*"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- Rate limiting (requests per minute per IP) ---
RATE_LIMIT_GLOBAL_PER_MIN=100
# Stricter limit for auth endpoints (login, register, password reset)
RATE_LIMIT_AUTH_PER_MIN=5
# Consecutive failed logins before a per-account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000

# --- Security ---
# Enable HSTS in production
ENABLE_HSTS=false
# Max upload size in bytes (default 5MB)
MAX_UPLOAD_BYTES=5242880
# Allowed image MIME types
ALLOWED_IMAGE_MIMES="image/jpeg,image/png,image/webp"
# Directory for uploaded files (outside web root)
UPLOAD_DIR="./uploads"

# --- Feature flags / assumed defaults (see KNOWN_GAPS.md) ---
# When true, record_flags escalate to principal automatically via the escalation job.
RECORD_FLAG_ESCALATION_ENABLED=true
# Number of days an open flag stays unresolved before escalation.
RECORD_FLAG_ESCALATION_DAYS=7
